# ============================================
# FastAPI Application Settings
# ============================================
APP_NAME=RAG-Inference-Platform
APP_VERSION=1.0.0
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=*

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ============================================
# Ollama Server Cluster Configuration
# ============================================
# Format: OLLAMA_SERVERS=host1:port,host2:port,host3:port
OLLAMA_SERVERS=http://server-a:11434,http://server-b:11434,http://server-c:11434

# Model to server mapping (JSON format)
# Example: {"deepseek-coder":"server-a","llama3.2":"server-b","qwen2.5":"server-c"}
MODEL_SERVER_MAP={"deepseek-coder":"server-a","llama3.2":"server-b","qwen2.5":"server-c"}

# Default model
DEFAULT_MODEL=llama3.2

# Embedding model
EMBEDDING_MODEL=nomic-embed-text

# Fallback servers (comma-separated)
FALLBACK_SERVERS=http://server-b:11434,http://server-c:11434

# Load balancing strategy: round_robin, weighted, least_load
LOAD_BALANCING_STRATEGY=weighted

# ============================================
# Health Monitoring
# ============================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
UNHEALTHY_THRESHOLD=3
RECOVERY_THRESHOLD=2

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=rag_memories
QDRANT_VECTOR_SIZE=768

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rag_platform

# Database URL (SQLAlchemy format)
DATABASE_URL=postgresql+asyncpg://rag_user:change_me_in_production@localhost:5432/rag_platform

# ============================================
# RAG Pipeline Settings
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_MEMORIES=5
MAX_CONTEXT_LENGTH=4096
SIMILARITY_THRESHOLD=0.7

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Retry & Timeout
# ============================================
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=1

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090